# frozen_string_literal: true

source 'https://rubygems.org'

# Runtime has no third-party dependencies — the scripts use only the Ruby
# stdlib (open3, json, rexml, uri, yaml, fileutils, set) plus external CLIs
# (ffmpeg, ffprobe, nlm, aws). Keep it that way.
group :development, :test do
  gem 'minitest', '~> 5.0'
  gem 'rake', '~> 13.0'
end
